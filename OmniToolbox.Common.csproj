<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.CN.NET.Sdk/15.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <DalamudApiLevel>15</DalamudApiLevel>
    <AssemblyName>OmniToolbox.Common</AssemblyName>
    <RootNamespace>OmniToolbox</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Use_DalamudPackager>false</Use_DalamudPackager>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <NuGetLockFilePath>$(BaseIntermediateOutputPath)$(MSBuildProjectName).packages.lock.json</NuGetLockFilePath>
    <NoWarn>$(NoWarn);Dalamud001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="DailyRoutines.CodeAnalysis" Version="2.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\lib\KamiToolKit\KamiToolKit.csproj" />
    <ProjectReference Include="..\lib\OmenTools\OmenTools.csproj" />
    <ProjectReference Include="..\lib\TreeTools\TreeTools.csproj" />
    <ProjectReference Include="..\lib\TreeToolKit\TreeToolKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OmniToolbox" />
    <InternalsVisibleTo Include="OmniToolbox.Tree" />
    <InternalsVisibleTo Include="OmniToolbox.TreePublic" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\DATA_SOURCES.md"
                      Link="Data\DATA_SOURCES.md"
                      LogicalName="OmniToolbox.Data.DATA_SOURCES.md" />
    <EmbeddedResource Include="Data\Resources\**\*.csv;Data\Resources\**\*.json;Data\Resources\**\*.txt"
                      Link="Data\%(Filename)%(Extension)"
                      LogicalName="OmniToolbox.Data.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Data\resource-manifest.json"
                      LogicalName="OmniToolbox.Data.resource-manifest.json" />
    <EmbeddedResource Include="Data\Resources\UI\边框.png"
                      Link="Resources\边框.png"
                      LogicalName="OmniToolbox.Resources.边框.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\OmniToolbox.Localizations\*.xlf"
                      Link="Localization\%(Filename)%(Extension)"
                      LogicalName="OmniToolbox.Localization.Official.%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="GenerateOmniRuntimeData" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveProjectReferences"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <OmniRuntimeDataDirectory>$(IntermediateOutputPath)GameDataRuntime</OmniRuntimeDataDirectory>
      <OmniGameDataBuildDirectory>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'GameDataBuild'))</OmniGameDataBuildDirectory>
      <OmniTreeToolsProject>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', 'lib', 'TreeTools', 'TreeTools.csproj'))</OmniTreeToolsProject>
      <OmniGameDataToolPath>$(OmniGameDataBuildDirectory)\bin\TreeTools.dll</OmniGameDataToolPath>
      <OmniRuntimeDotNetHost Condition="'$(DotNetHostPath)' != ''">$(DotNetHostPath)</OmniRuntimeDotNetHost>
      <OmniRuntimeDotNetHost Condition="'$(OmniRuntimeDotNetHost)' == ''">dotnet</OmniRuntimeDotNetHost>
    </PropertyGroup>
    <Exec Command="&quot;$(OmniRuntimeDotNetHost)&quot; build &quot;$(OmniTreeToolsProject)&quot; -c $(Configuration) --artifacts-path &quot;$(OmniGameDataBuildDirectory)\artifacts&quot; &quot;-p:OutputPath=$(OmniGameDataBuildDirectory)\bin&quot; -p:TreeToolsGameDataTool=true -p:UseSharedCompilation=false --disable-build-servers -m:1 --nologo"
          UseUtf8Encoding="Always" StdOutEncoding="utf-8" StdErrEncoding="utf-8" />
    <Exec Command="&quot;$(OmniRuntimeDotNetHost)&quot; &quot;$(OmniGameDataToolPath)&quot; generate --data-directory &quot;$(MSBuildProjectDirectory)\Data&quot; --output-directory &quot;$(OmniRuntimeDataDirectory)&quot;"
          UseUtf8Encoding="Always" StdOutEncoding="utf-8" StdErrEncoding="utf-8" />
    <ItemGroup>
      <OmniRuntimeDataFile Include="$(OmniRuntimeDataDirectory)\*.msgpack;$(OmniRuntimeDataDirectory)\embedded-index.json" />
      <EmbeddedResource Include="@(OmniRuntimeDataFile)"
                        LogicalName="OmniToolbox.Data.Runtime.%(OmniRuntimeDataFile.Filename)%(OmniRuntimeDataFile.Extension)"
                        Type="Non-Resx" WithCulture="false" />
      <FileWrites Include="@(OmniRuntimeDataFile)" />
    </ItemGroup>
  </Target>

</Project>
